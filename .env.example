# 艺术设计专业版 Go 服务器环境变量模板
# 复制此文件到 .env 并更新为本地值。程序不会自动读取 .env，启动前需导出这些变量。
# 
# 重要提示:
# - 请勿将 .env 文件提交到版本控制
# - 在生产环境中使用强密码、唯一值
# - 定期轮换密钥

# 服务器配置
HTTP_SERVICES_SERVER_PORT=8080
HTTP_SERVICES_SERVER_TRUSTED_PROXIES=

# JWT 配置
# 生成强随机密钥: openssl rand -base64 32
HTTP_SERVICES_JWT_KEY=
HTTP_SERVICES_JWT_EXPIRATION=12h

# Redis 配置
HTTP_SERVICES_REDIS_HOST=127.0.0.1:6379
HTTP_SERVICES_REDIS_PASSWORD=

# PostgreSQL 配置
HTTP_SERVICES_POSTGRES_HOST=127.0.0.1
HTTP_SERVICES_POSTGRES_USER=postgres
HTTP_SERVICES_POSTGRES_PASSWORD=
HTTP_SERVICES_POSTGRES_DBNAME=server
HTTP_SERVICES_POSTGRES_PORT=5432
HTTP_SERVICES_POSTGRES_SSLMODE=disable
HTTP_SERVICES_POSTGRES_TIMEZONE=Asia/Shanghai

# 管理员配置
# 为管理员用户使用强密码
HTTP_SERVICES_ADMIN_PASSWORD=
# 生成强盐值: openssl rand -base64 32
HTTP_SERVICES_ADMIN_SALT=

# Docker Compose 默认只把数据库端口绑定到本机；确需远程访问时再显式调整并配置防火墙。
DOCKER_BIND_ADDRESS=127.0.0.1

# 安全说明:
# 1. HTTP_SERVICES_JWT_KEY 应至少32个字符且为密码学随机数
# 2. HTTP_SERVICES_ADMIN_SALT 应唯一且绝不分享
# 3. 所有密码都应遵循强密码策略
# 4. 在生产环境中，考虑使用密钥管理服务

# 常见生成密钥命令:
# JWT 密钥 (32+ 字符): openssl rand -base64 32
# 密码盐值 (32+ 字符): openssl rand -base64 32
# 强密码: openssl rand -base64 24
