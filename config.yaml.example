# HTTP Service 配置示例
# 复制为 config.yaml 并替换占位值；所有字段都可用环境变量 HTTP_SERVICES_<SECTION>_<KEY> 覆盖

server:
  port: 8080
  max_body_size: "10MB"
  max_header_bytes: 1048576
  trusted_proxies: []             # 反向代理的 IP/CIDR；直连部署保持为空
  shutdown_timeout: "10s"
  read_timeout: "30s"
  write_timeout: "30s"
  idle_timeout: "120s"
  enable_rate_limit: false
  global_rate_limit: 100
  global_rate_burst: 200
  pid_file: "api-server.pid"     # pid 文件路径（支持相对路径，相对程序所在目录）；服务退出时会自动删除
  # 可选 TLS 配置（二选一）：ACME 自动证书 或 本地证书文件
  enable_acme: false
  acme_domain: ""
  acme_cache_dir: "acme-cert-cache"
  enable_tls: false
  tls_cert_file: ""
  tls_key_file: ""

jwt:
  key: ""                       # 必填，请生成至少32字符的随机密钥
  expiration: "12h"

log:
  max_size: 50
  max_backups: 3
  max_age: 30

redis:
  host: "127.0.0.1:6379"
  password: ""                    # 必填，不提交真实密码

postgres:
  host: "127.0.0.1"
  user: "postgres"
  password: ""                    # 必填，不提交真实密码
  dbname: "server"
  port: 5432
  sslmode: "disable"
  timezone: "Asia/Shanghai"

admin:
  password: ""                    # 必填，长度 8-72 字节
  salt: ""                        # 必填，使用随机值

rate_limit:
  login_rate_per_minute: 30
  login_burst_size: 60
  general_rate_per_sec: 100
  general_burst_size: 200

tenant:
  min_query_length: 3
  default_code: "platform"
